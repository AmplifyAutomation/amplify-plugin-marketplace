# Docker Compose for Production Deployment
# Project: {{PROJECT_NAME}}
# Generated by webapp-initializer agent
#
# Deploy to Digital Ocean Droplet or any Docker-compatible VPS
# See docs/DEPLOYMENT.md for detailed instructions

version: '3.8'

services:
  # Next.js/React Application (Production Build)
  app:
    build:
      context: .
      dockerfile: docker/Dockerfile.prod
    container_name: {{PROJECT_NAME}}-app-prod
    restart: unless-stopped
    environment:
      - NODE_ENV=production
    env_file:
      - .env.production
    expose:
      - "3000"
    networks:
      - app-network
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 40s

  # Nginx Reverse Proxy with SSL
  nginx:
    image: nginx:alpine
    container_name: {{PROJECT_NAME}}-nginx
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./docker/nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./docker/nginx/conf.d:/etc/nginx/conf.d:ro
      - ./certbot/conf:/etc/letsencrypt:ro
      - ./certbot/www:/var/www/certbot:ro
    depends_on:
      - app
    networks:
      - app-network

  # Certbot for SSL Certificate Management
  certbot:
    image: certbot/certbot
    container_name: {{PROJECT_NAME}}-certbot
    volumes:
      - ./certbot/conf:/etc/letsencrypt
      - ./certbot/www:/var/www/certbot
    entrypoint: "/bin/sh -c 'trap exit TERM; while :; do certbot renew; sleep 12h & wait $${!}; done;'"

  # PostgreSQL Database (Production)
  db:
    image: postgres:15-alpine
    container_name: {{PROJECT_NAME}}-db-prod
    restart: unless-stopped
    environment:
      POSTGRES_USER: ${DB_USER}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_NAME}
    volumes:
      - postgres_data_prod:/var/lib/postgresql/data
      - ./backups:/backups
    networks:
      - app-network
    # Note: In production, don't expose the database port externally
    # Use SSH tunneling for database access

  # Redis Cache (optional - uncomment if needed)
  # redis:
  #   image: redis:7-alpine
  #   container_name: {{PROJECT_NAME}}-redis-prod
  #   restart: unless-stopped
  #   volumes:
  #     - redis_data_prod:/data
  #   networks:
  #     - app-network

volumes:
  postgres_data_prod:
    name: {{PROJECT_NAME}}-postgres-data-prod
  # redis_data_prod:
  #   name: {{PROJECT_NAME}}-redis-data-prod

networks:
  app-network:
    name: {{PROJECT_NAME}}-network-prod
    driver: bridge
