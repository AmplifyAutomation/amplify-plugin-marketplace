#!/bin/bash
# Project Initialization Script
# Generated by webapp-initializer agent
set -e

PROJECT_NAME="{{PROJECT_NAME}}"

echo "🚀 Initializing ${PROJECT_NAME}..."
echo ""

# Color codes for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print status
print_status() {
    echo -e "${GREEN}✓${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}⚠${NC} $1"
}

print_error() {
    echo -e "${RED}✗${NC} $1"
}

# Check for required tools
echo "Checking prerequisites..."

if ! command -v docker &> /dev/null; then
    print_error "Docker is required but not installed."
    echo "Install Docker: https://docs.docker.com/get-docker/"
    exit 1
fi
print_status "Docker found"

if ! command -v docker compose &> /dev/null && ! command -v docker-compose &> /dev/null; then
    print_error "Docker Compose is required but not installed."
    exit 1
fi
print_status "Docker Compose found"

if ! command -v node &> /dev/null; then
    print_warning "Node.js not found locally (will use Docker for all operations)"
else
    NODE_VERSION=$(node -v)
    print_status "Node.js found: ${NODE_VERSION}"
fi

echo ""

# Copy environment file if not exists
if [ ! -f .env ]; then
    if [ -f .env.example ]; then
        cp .env.example .env
        print_status "Created .env file from template"
        print_warning "Please update .env with your actual values before running"
    else
        print_error "No .env.example file found"
        exit 1
    fi
else
    print_status ".env file already exists"
fi

echo ""

# Make all scripts executable
echo "Setting up scripts..."
chmod +x scripts/*.sh 2>/dev/null || true
print_status "Made scripts executable"

echo ""

# Build and start development containers
echo "Building Docker containers (this may take a few minutes)..."
docker compose build

echo ""
echo "Starting development environment..."
docker compose up -d

echo ""
echo "Waiting for services to be ready..."
sleep 5

# Check if services are running
if docker compose ps | grep -q "Up"; then
    print_status "Services are running"
else
    print_error "Some services failed to start. Check logs with: docker compose logs"
    exit 1
fi

echo ""
echo "==========================================="
echo -e "${GREEN}✅ Initialization complete!${NC}"
echo "==========================================="
echo ""
echo "Your development environment is now running:"
echo "  📱 App:      http://localhost:3000"
echo "  🗄️  Database: localhost:5432"
echo ""
echo "Useful commands:"
echo "  📋 View logs:    docker compose logs -f"
echo "  🛑 Stop:         docker compose down"
echo "  🔄 Restart:      docker compose restart"
echo "  🔨 Rebuild:      docker compose up --build"
echo "  🧹 Clean reset:  docker compose down -v && docker compose up --build"
echo ""
echo "Next steps:"
echo "  1. Open http://localhost:3000 in your browser"
echo "  2. Update .env with your actual configuration"
echo "  3. Start developing! 🎉"
echo ""
